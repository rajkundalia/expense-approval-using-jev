# Reference values only: the application does not automatically read .env files.
# Explicitly pass a mapping to expense_approval.settings.load_settings.
# To use process variables, call load_settings(os.environ) in your caller.
# The API key is optional for deterministic functionality and offline tests.
# Experiments continue to read their key from the process environment.
OPENROUTER_API_KEY=replace-with-your-own-openrouter-api-key

# Provisional defaults, not calibrated thresholds. Both accept finite values [0, 1].
# Missing thresholds use defaults; explicit blank or invalid values raise errors.
JEV_MIN_CONFIDENCE=0.70
JEV_MIN_PROBABILITY_MARGIN=0.30

# Retain typesafe-sdk==0.7.5 and model typesafe/jev-1.14-20261014.
# OpenRouter base_url: https://openrouter.ai/api (SDK appends /v1/systemone).
# Historical J1 uses typesafe/jev-1.14 and checks the canonical snapshot.
